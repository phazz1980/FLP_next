;; Test module for the PC/board comparison: deterministic, no hardware, no time.
;; out0 = running sum of in0 + param0 * dt / 1000     out1 = step count
;; out2 = 2 * tag1 + in1 (tag1 = step count)           out3 = messages received
;; Every second step it publishes "tick" to itself (delivered after the step).
(module
  (import "flp" "input" (func $input (param i32) (result f64)))
  (import "flp" "param" (func $param (param i32) (result f64)))
  (import "flp" "output" (func $output (param i32 f64)))
  (import "flp" "tag_get" (func $tag_get (param i32) (result f64)))
  (import "flp" "tag_set" (func $tag_set (param i32 f64)))
  (import "flp" "publish" (func $publish (param i32 i32 i32 i32)))
  (import "flp" "subscribe" (func $subscribe (param i32 i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "tick")
  (global $acc (mut f64) (f64.const 0))
  (global $steps (mut f64) (f64.const 0))
  (global $msgs (mut f64) (f64.const 0))
  (global $heap (mut i32) (i32.const 1024))
  (func (export "abi_version") (result i32) i32.const 2)
  (func (export "init") (call $subscribe (i32.const 0) (i32.const 4)))
  (func (export "alloc") (param $n i32) (result i32)
    (local $p i32)
    (if (i32.gt_u (global.get $heap) (i32.const 60000))
      (then (global.set $heap (i32.const 1024))))
    (local.set $p (global.get $heap))
    (global.set $heap (i32.add (local.get $p) (local.get $n)))
    (local.get $p))
  (func (export "on_message") (param i32 i32 i32 i32)
    (global.set $msgs (f64.add (global.get $msgs) (f64.const 1))))
  (func (export "step") (param $dt i32)
    (global.set $steps (f64.add (global.get $steps) (f64.const 1)))
    (global.set $acc
      (f64.add (global.get $acc)
        (f64.add (call $input (i32.const 0))
          (f64.div (f64.mul (call $param (i32.const 0)) (f64.convert_i32_s (local.get $dt)))
                   (f64.const 1000)))))
    (call $tag_set (i32.const 1) (global.get $steps))
    (call $output (i32.const 0) (global.get $acc))
    (call $output (i32.const 1) (global.get $steps))
    (call $output (i32.const 2)
      (f64.add (f64.mul (call $tag_get (i32.const 1)) (f64.const 2)) (call $input (i32.const 1))))
    (call $output (i32.const 3) (global.get $msgs))
    (if (i32.eqz (i32.and (i32.trunc_f64_u (global.get $steps)) (i32.const 1)))
      (then (call $publish (i32.const 0) (i32.const 4) (i32.const 0) (i32.const 4))))))
