;; Test module for the PC/board comparison: deterministic, no hardware, no time. ABI v3.
;; out0 (float) = running sum of in0 + param0 * dt / 1000
;; out1 (int)   = step count + in2 (wrapping)
;; out2 (float) = 2 * tag1 + in1 (tag1 = step count as float)
;; out3 (int)   = messages received
;; Every second step it publishes "tick" to itself (delivered after the step).
(module
  (import "crab" "input_f" (func $input_f (param i32) (result f32)))
  (import "crab" "input_i" (func $input_i (param i32) (result i32)))
  (import "crab" "param_f" (func $param_f (param i32) (result f32)))
  (import "crab" "output_f" (func $output_f (param i32 f32) (result f32)))
  (import "crab" "output_i" (func $output_i (param i32 i32) (result i32)))
  (import "crab" "tag_get_f" (func $tag_get_f (param i32) (result f32)))
  (import "crab" "tag_set_f" (func $tag_set_f (param i32 f32)))
  (import "crab" "publish" (func $publish (param i32 i32 i32 i32)))
  (import "crab" "subscribe" (func $subscribe (param i32 i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "tick")
  (global $acc (mut f32) (f32.const 0))
  (global $steps (mut i32) (i32.const 0))
  (global $msgs (mut i32) (i32.const 0))
  (global $heap (mut i32) (i32.const 1024))
  (func (export "abi_version") (result i32) i32.const 3)
  (func (export "init") (call $subscribe (i32.const 0) (i32.const 4)))
  (func (export "alloc") (param $n i32) (result i32)
    (local $p i32)
    (if (i32.gt_u (global.get $heap) (i32.const 60000))
      (then (global.set $heap (i32.const 1024))))
    (local.set $p (global.get $heap))
    (global.set $heap (i32.add (local.get $p) (local.get $n)))
    (local.get $p))
  (func (export "on_message") (param i32 i32 i32 i32)
    (global.set $msgs (i32.add (global.get $msgs) (i32.const 1))))
  (func (export "step") (param $dt i32)
    (global.set $steps (i32.add (global.get $steps) (i32.const 1)))
    (global.set $acc
      (f32.add (global.get $acc)
        (f32.add (call $input_f (i32.const 0))
          (f32.div (f32.mul (call $param_f (i32.const 0)) (f32.convert_i32_s (local.get $dt)))
                   (f32.const 1000)))))
    (call $tag_set_f (i32.const 1) (f32.convert_i32_s (global.get $steps)))
    (drop (call $output_f (i32.const 0) (global.get $acc)))
    (drop (call $output_i (i32.const 1) (i32.add (global.get $steps) (call $input_i (i32.const 2)))))
    (drop (call $output_f (i32.const 2)
      (f32.add (f32.mul (call $tag_get_f (i32.const 1)) (f32.const 2)) (call $input_f (i32.const 1)))))
    (drop (call $output_i (i32.const 3) (global.get $msgs)))
    (if (i32.eqz (i32.and (global.get $steps) (i32.const 1)))
      (then (call $publish (i32.const 0) (i32.const 4) (i32.const 0) (i32.const 4))))))
