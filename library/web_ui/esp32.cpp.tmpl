bool {{ id }}_allowed(FLProgNetworkHttpServer *server) {
  const char *pw = {{ param.password }};
  if (!pw[0] || server->argumentValueAtKey("k") == pw) return true;
  server->send(403, "text/plain", "auth");
  return false;
}
