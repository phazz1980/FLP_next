if ({{ input.save }} && !{{ id }}_prev && {{ input.in }} != {{ output.out }}) {
  {{ output.out }} = {{ input.in }};
  {{ id }}_prefs.putFloat("{{ id[:15] }}", {{ output.out }});
}
{{ id }}_prev = {{ input.save }};
