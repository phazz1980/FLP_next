// @functions
// The page sends the whole form as ten lines (ssid, password, dhcp, ip, gateway, subnet, ap ssid, ap password, mode, ap delay); an empty password keeps the saved one.
String {{ id }}_line(const String &s, int n) {
  int from = 0;
  for (int k = 0; k < n; k++) {
    int p = s.indexOf('\n', from);
    if (p < 0) return String();
    from = p + 1;
  }
  int e = s.indexOf('\n', from);
  return e < 0 ? s.substring(from) : s.substring(from, e);
}
void {{ id }}_show() {
  {{ id }}_ui.text = flpNet.f[0] + "\n\n" + flpNet.f[2] + "\n" + flpNet.f[3] + "\n" + flpNet.f[4] + "\n" + flpNet.f[5] + "\n" + flpNet.f[6] + "\n\n" + flpNet.f[8] + "\n" + flpNet.f[9];
}
static bool {{ id }}_pwok(const String &p) {
  if (p.length() == 0) return true;
  for (size_t k = 0; k < p.length(); k++) if (p[k] < 32 || p[k] > 126) return false;
  if (p.length() >= 8 && p.length() <= 63) return true;
  if (p.length() != 64) return false;
  for (size_t k = 0; k < 64; k++) if (!isxdigit(p[k])) return false;
  return true;
}
static bool {{ id }}_ssidok(const String &s) {
  if (s.length() > 32) return false;
  for (size_t k = 0; k < s.length(); k++) if ((uint8_t)s[k] < 32) return false;
  return true;
}
// @setup
{{ id }}_prefs.begin("flp", false);
// Defaults come from the editor: when they change (a new flash with other settings), the saved page values are dropped.
{
  String init[10] = { {{ param.init_ssid }}, {{ param.init_password }}, "{{ 1 if value.init_dhcp else 0 }}", {{ param.init_ip }}, {{ param.init_gateway }}, {{ param.init_subnet }}, {{ param.init_ap_ssid }}, {{ param.init_ap_password }}, "{{ value.init_mode }}", "{{ value.init_ap_delay }}"};
  uint32_t sig = 2166136261UL;
  for (int k = 0; k < 10; k++) {
    for (size_t n = 0; n < init[k].length(); n++) sig = (sig ^ (uint8_t)init[k][n]) * 16777619UL;
    sig = (sig ^ 0xFF) * 16777619UL;
  }
  if ({{ id }}_prefs.getUInt("{{ id[:12] }}_h", 0) != sig) {
    static const char *keys[10] = {"_s", "_p", "_d", "_i", "_g", "_m", "_a", "_b", "_o", "_w"};
    for (int k = 0; k < 10; k++) {{ id }}_prefs.remove((String("{{ id[:12] }}") + keys[k]).c_str());
    {{ id }}_prefs.putUInt("{{ id[:12] }}_h", sig);
  }
}
flpNet.f[0] = {{ id }}_prefs.getString("{{ id[:12] }}_s", {{ param.init_ssid }});
flpNet.f[1] = {{ id }}_prefs.getString("{{ id[:12] }}_p", {{ param.init_password }});
flpNet.f[2] = {{ id }}_prefs.getString("{{ id[:12] }}_d", "{{ 1 if value.init_dhcp else 0 }}");
flpNet.f[3] = {{ id }}_prefs.getString("{{ id[:12] }}_i", {{ param.init_ip }});
flpNet.f[4] = {{ id }}_prefs.getString("{{ id[:12] }}_g", {{ param.init_gateway }});
flpNet.f[5] = {{ id }}_prefs.getString("{{ id[:12] }}_m", {{ param.init_subnet }});
flpNet.f[6] = {{ id }}_prefs.getString("{{ id[:12] }}_a", {{ param.init_ap_ssid }});
flpNet.f[7] = {{ id }}_prefs.getString("{{ id[:12] }}_b", {{ param.init_ap_password }});
flpNet.f[8] = {{ id }}_prefs.getString("{{ id[:12] }}_o", "{{ value.init_mode }}");
flpNet.f[9] = {{ id }}_prefs.getString("{{ id[:12] }}_w", "{{ value.init_ap_delay }}");
{{ id }}_show();
flpUiAdd(&{{ id }}_ui);
{{ id }}_ui.color = {{ param.color }};
{{ id }}_ui.back = {{ param.back }};
// @loop
{{ output.changed }} = false;
if ({{ id }}_ui.value != 0) {
  {{ id }}_ui.value = 0;
  String t = {{ id }}_ui.text;
  String pw = {{ id }}_line(t, 1);
  String apw = {{ id }}_line(t, 7);
  String nf[10] = { {{ id }}_line(t, 0), pw.length() ? pw : flpNet.f[1], {{ id }}_line(t, 2), {{ id }}_line(t, 3), {{ id }}_line(t, 4), {{ id }}_line(t, 5), {{ id }}_line(t, 6), apw.length() ? apw : flpNet.f[7], {{ id }}_line(t, 8), {{ id }}_line(t, 9)};
  bool valid = {{ id }}_pwok(pw) && {{ id }}_pwok(apw) && {{ id }}_ssidok(nf[0]) && {{ id }}_ssidok(nf[6]);
  static const char *keys[10] = {"_s", "_p", "_d", "_i", "_g", "_m", "_a", "_b", "_o", "_w"};
  for (int k = 0; k < 10 && valid; k++) {
    if (nf[k] != flpNet.f[k]) {
