// @loop
{% set tables = {"holding": "FLPROG_HOLDING_REGISTR", "input": "FLPROG_INPUT_REGISTR", "coil": "FLPROG_COIL", "discrete": "FLPROG_DISCRETE_INPUT"} %}
{% if value.kind == "float" %}{{ output.out_f }} = flpMaster.readFloat({{ param.slave }}, {{ tables[value.table] }}, {{ param.reg }});
{% elif value.kind == "bool" %}{{ output.out_b }} = flpMaster.readBool({{ param.slave }}, {{ tables[value.table] }}, {{ param.reg }});
{% else %}{{ output.out }} = flpMaster.readInteger({{ param.slave }}, {{ tables[value.table] }}, {{ param.reg }});
{% endif %}
{{ output.ok }} = flpMaster.slaveStatus({{ param.slave }}, false);
