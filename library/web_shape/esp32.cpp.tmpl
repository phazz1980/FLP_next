// @global
// The shape code travels in `lo` and the thickness in `hi` (a shape has no value).
FlpUiItem {{ id }}_ui = {"web_shape", {{ param.caption }}, "", {{ value.col }}, {{ value.row }}, {{ value.w }}, {{ value.h }}, {{ value.page }}, false, 0, {{ value.shape }}, {{ value.thickness }}, 0, 0};
// @setup
flpUiAdd(&{{ id }}_ui);
{{ id }}_ui.color = {{ param.color }};
{{ id }}_ui.back = {{ param.back }};
